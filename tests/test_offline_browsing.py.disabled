# Controls

def test_source_controls_are_disabled_offline_with_the_reason(
        qtbot: QtBot, offline_restart: tuple[IOService, FolderCache, Path]) -> None:
    service, cache, data = offline_restart
    explorer = open_tab(qtbot, service, data)
    assert not explorer.retry_button.isEnabled()
    for control in (explorer.refresh_action, explorer.check_status_action, explorer.live_action):
        assert not control.isEnabled() and "Not while working offline" in control.toolTip()
    menu = explorer.context_menu_for(str(data))  # TODO(C3): the context menu's builder, by path.
    disabled = {action.text() for action in menu.actions() if not action.isEnabled()}
    assert {"Retry / Refresh", "Place .helab-root here…", "Open in File Manager"} <= disabled
    explorer.close_cleanup()


def test_live_refuses_to_start_offline(
        qtbot: QtBot, offline_restart: tuple[IOService, FolderCache, Path]) -> None:
    service, cache, data = offline_restart
    explorer = open_tab(qtbot, service, data)
    assert not explorer.start_live()
    assert "Live is off while working offline" in explorer.summary_text()
    explorer.close_cleanup()


