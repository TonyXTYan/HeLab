"""Cache-only browsing (C3), DRAFT: not collected until C3 lands (``.disabled``; see
.ai/sessions/2026-10-26-claude-cache-only/design.md, "C3 plan"). Rename to ``.py`` with C3.

Every test runs with source access denied: ``no_source_io`` fails the test if a source-folder
operation reaches ``IOService._start`` while offline, and the source folders are deleted before
going offline where a test says "restart". What runs offline is local-lane work only: ``cached``,
``saved_list``, ``cache_admin``, ``result_find`` / ``result_save``, ``volumes_verify`` and the rest
of design.md §5's allowed list.

Placeholders until D2 names the control: ``FolderCache.set_offline`` / ``offline``,
``IOService.offline``, ``OFFLINE_OPERATIONS``, the event ``{"kind": "offline"}``,
``io_ops.listings.saved_list_folder``.
"""
from __future__ import annotations

import os
from pathlib import Path
import shutil
from typing import Any, Callable, Iterator

import numpy as np
import pytest
from pytestqt.qtbot import QtBot

from helab.io_helper import SOURCE_OPERATIONS
from helab.io_ops.browse import list_folder
from helab.io_ops.listings import saved_list_folder
from helab.io_ops.loading import load, read_cached
from helab.utils.folder_cache import FolderCache, get_folder_cache, store_options
from helab.utils.io_service import IORequest, IOService
from helab.views.FolderExplorer import FolderExplorer

# Source operations beyond the helper's guard list: they probe paths or markers on mounts.
SOURCE = frozenset(SOURCE_OPERATIONS | {"resolve", "roots_verify", "details", "scan"})


# The seam

@pytest.fixture
def no_source_io(monkeypatch: pytest.MonkeyPatch) -> Iterator[list[IORequest]]:
    """Fail at once if any source operation starts while its service is offline; returns what
    started (local-lane work), for tests that check exactly what ran."""
    started: list[IORequest] = []
    real_start = IOService._start

    def start(service: IOService, request: IORequest, lane: str) -> None:
        if service.offline and request.operation in SOURCE:
            pytest.fail(f"Source operation started offline: {request.operation} {request.path}")
        started.append(request)
        real_start(service, request, lane)
    monkeypatch.setattr(IOService, "_start", start)
    yield started


def frozen_service(monkeypatch: pytest.MonkeyPatch) -> IOService:
    """A service whose requests wait in ``pending`` until a test answers them (``answer``)."""
    service = IOService()
    service.timer.stop()
    monkeypatch.setattr(service, "_dispatch", lambda: None)
    monkeypatch.setattr("helab.models.SnapshotFileSystemModel.get_io_service", lambda: service)
    return service


def answer(qtbot: QtBot, service: IOService, operation: str, path: str,
           helper: Callable[[Callable[[Any], None]], None]) -> None:
    """Answer the pending ``operation`` request for ``path`` with a real helper's events. As
    ``no_source_io`` would, it fails if the request is a source operation while offline."""
    qtbot.waitUntil(lambda: any(r.operation == operation and r.path == path for r in service.pending))
    request = next(r for r in service.pending if r.operation == operation and r.path == path)
    assert not (service.offline and operation in SOURCE), f"{operation} {path} submitted offline"

    def send(event: Any) -> None:
        if event["kind"] == "shot":
            event = {**event, "array": np.load(event["artifact"])}
        service.resultReady.emit(request, event)
    helper(send)
    service.resultReady.emit(request, {"kind": "done"})
    service.pending.remove(request)


# A tree listed and loaded while online, then the source gone

def experiment(tmp_path: Path) -> Path:
    """``data/2026-10-20/run_1`` (2 shots) and ``run_2`` (no data), ``data/2026-10-21`` (never listed)."""
    data = tmp_path / "data"
    for folder in ("2026-10-20/run_1", "2026-10-20/run_2", "2026-10-21/run_3"):
        (data / folder).mkdir(parents=True)
    for shot in (1, 2):
        (data / "2026-10-20/run_1" / f"d{shot}.txt").write_text("")
        (data / "2026-10-20/run_1" / f"d_txy_forc{shot}.txt").write_text(f"{shot},2,3\n")
    return data


def browse_online(tmp_path: Path, data: Path) -> None:
    """What an online session leaves in the disk cache: listings of the root, one day and its
    runs, and run_1's dataset."""
    options = store_options()
    for folder in (data, data / "2026-10-20", data / "2026-10-20/run_1", data / "2026-10-20/run_2"):
        list_folder(str(folder), lambda event: None, options)
    output = tmp_path / "artifacts"
    output.mkdir()
    load(str(data / "2026-10-20/run_1"), str(output), lambda event: None, options)


@pytest.fixture
def offline_restart(qtbot: QtBot, monkeypatch: pytest.MonkeyPatch, tmp_path: Path,
                    no_source_io: list[IORequest]) -> Iterator[tuple[IOService, FolderCache, Path]]:
    """A restart with the source deleted: a fresh service and cache, offline from the start."""
    data = experiment(tmp_path)
    browse_online(tmp_path, data)
    shutil.rmtree(data)
    service = frozen_service(monkeypatch)
    cache = get_folder_cache(service)
    cache.set_offline(True)
    yield service, cache, data
    service.shutdown()


def open_tab(qtbot: QtBot, service: IOService, data: Path) -> FolderExplorer:
    explorer = FolderExplorer(str(data), str(data), str(data), [0, 4, 5])
    qtbot.addWidget(explorer)
    answer(qtbot, service, "saved_list", str(data),
           lambda send: saved_list_folder(str(data), send, store_options()))
    return explorer


# The gate

@pytest.mark.parametrize("operation", sorted(SOURCE))
def test_the_gate_refuses_every_source_operation_offline(
        qtbot: QtBot, monkeypatch: pytest.MonkeyPatch, tmp_path: Path, operation: str) -> None:
    service = frozen_service(monkeypatch)
    cache = get_folder_cache(service)
    try:
        cache.set_offline(True)
        events: list[dict[str, Any]] = []
        cache.resultReady.connect(lambda request, event: events.append(event))
        # A tab's request is answered "offline", never queued, never a failure ("list" is
        # rewritten to the local lane's saved_list instead).
        accepted = cache.submit("tab", 0, str(tmp_path), operation, {"cache": store_options()})
        if operation == "list":
            assert [r.operation for r in service.pending] == ["saved_list"]
        else:
            assert accepted and not service.pending
            qtbot.waitUntil(lambda: any(event["kind"] == "offline" for event in events))
        # Anything bypassing FolderCache is refused at the service.
        assert not service.submit("raw", 0, str(tmp_path), operation, {})
    finally:
        service.shutdown()


@pytest.mark.parametrize("operation", ["cached", "cache_admin", "result_find", "result_save", "invalidate",
                                       "volumes_verify", "trace_check", "cache_move", "drives"])
def test_local_work_goes_on_offline(monkeypatch: pytest.MonkeyPatch, tmp_path: Path, operation: str) -> None:
    service = frozen_service(monkeypatch)
    try:
        service.set_offline(True)
        assert service.submit("local", 0, str(tmp_path), operation, {"cache": store_options()})
    finally:
        service.shutdown()


def test_entering_offline_cancels_source_work_and_lets_local_work_and_saves_finish(
        monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
    service = frozen_service(monkeypatch)
    cache = get_folder_cache(service)
    try:
        path = str(tmp_path)
        for operation in ("list", "scan", "icons", "load"):
            assert cache.submit("tab", 0, path, operation, {"cache": store_options(), "paths": [path]})
        assert cache.submit("tab", 0, path, "cached", {"cache": store_options()})
        assert cache.save("tab", path, {"cache": store_options()}) or True  # (No data in RAM: may refuse.)
        requests = {r.operation: r for r in service.pending}
        cache.set_offline(True)
        assert all(requests[op].cancelled.is_set() for op in ("list", "scan", "icons") if op in requests)
        assert not requests["cached"].cancelled.is_set()
        # TODO(C3): a load with ``save`` already started finishes (design.md §2), a plain load is cancelled.
    finally:
        service.shutdown()


# Navigation on saved listings

def test_a_restart_offline_navigates_saved_listings_with_their_counts(
        qtbot: QtBot, offline_restart: tuple[IOService, FolderCache, Path]) -> None:
    service, cache, data = offline_restart
    explorer = open_tab(qtbot, service, data)
    model = explorer.model
    day, unlisted = str(data / "2026-10-20"), str(data / "2026-10-21")
    assert sorted(child.path for child in model.nodes[str(data)].children) == [day, unlisted]
    model.request_scan(day)
    answer(qtbot, service, "saved_list", day, lambda send: saved_list_folder(day, send, store_options()))
    run_1 = model.nodes[str(data / "2026-10-20/run_1")]
    assert run_1.report is not None and run_1.txy_count == 2 and run_1.cached_report
    assert "Offline: showing saved results from" in model._tooltip(run_1, "")
    explorer.close_cleanup()


def test_a_folder_never_listed_says_so_and_has_no_expand_arrow(
        qtbot: QtBot, offline_restart: tuple[IOService, FolderCache, Path]) -> None:
    service, cache, data = offline_restart
    explorer = open_tab(qtbot, service, data)
    unlisted = str(data / "2026-10-21")
    explorer.model.request_scan(unlisted)
    answer(qtbot, service, "saved_list", unlisted, lambda send: saved_list_folder(unlisted, send, store_options()))
    node = explorer.model.nodes[unlisted]
    assert node.offline_unlisted and not explorer.model.hasChildren(explorer.model.path_index(unlisted))
    assert "Not listed while online" in explorer.model._tooltip(node, "")
    assert node.state == "idle" and not node.error
    explorer.close_cleanup()


def test_paths_above_data_roots_lead_down_to_the_known_roots(
        qtbot: QtBot, offline_restart: tuple[IOService, FolderCache, Path]) -> None:
    service, cache, data = offline_restart
    top = str(data.parent.parent)  # Above tmp_path's .helab-root (conftest's temporary data root).
    explorer = FolderExplorer(top, top, top, [0, 4, 5])
    qtbot.addWidget(explorer)
    answer(qtbot, service, "saved_list", top, lambda send: saved_list_folder(top, send, store_options()))
    assert [child.path for child in explorer.model.nodes[top].children] == [str(data.parent)]
    explorer.close_cleanup()


def test_rendering_and_scrolling_offline_request_no_icons_or_checks(
        qtbot: QtBot, offline_restart: tuple[IOService, FolderCache, Path],
        no_source_io: list[IORequest]) -> None:
    service, cache, data = offline_restart
    explorer = open_tab(qtbot, service, data)
    explorer.show()
    explorer._load_visible_icons()
    explorer._check_visible_folders()
    for index, _ in explorer.model.get_visible_rows():
        for role in range(0, 40):
            explorer.model.data(index, role)
    assert not [r for r in service.pending if r.operation in SOURCE]
    explorer.close_cleanup()


# Selection and data

def select(qtbot: QtBot, explorer: FolderExplorer, path: str) -> None:
    explorer.tree.setCurrentIndex(explorer.model.path_index(path))
    qtbot.waitUntil(lambda: explorer.selected_path_globally == path)


def test_selecting_a_cached_folder_reads_the_cache_only_and_says_not_checked(
        qtbot: QtBot, tmp_path: Path, offline_restart: tuple[IOService, FolderCache, Path]) -> None:
    service, cache, data = offline_restart
    explorer = open_tab(qtbot, service, data)
    day, run_1 = str(data / "2026-10-20"), str(data / "2026-10-20/run_1")
    explorer.model.request_scan(day)
    answer(qtbot, service, "saved_list", day, lambda send: saved_list_folder(day, send, store_options()))
    select(qtbot, explorer, run_1)
    output = tmp_path / "cached-read"
    output.mkdir()
    answer(qtbot, service, "cached", run_1, lambda send: read_cached(run_1, str(output), send, store_options()))
    qtbot.waitUntil(lambda: explorer.folder_opened_path == run_1)
    assert sorted(explorer.folder_opened_data or {}) == [1, 2]
    assert not any(r.operation == "load" for r in service.pending)
    assert "Offline" in explorer.summary_text() and "not checked" in explorer.summary_text()
    explorer.close_cleanup()


def test_a_folder_without_cached_data_says_so_and_loads_nothing(
        qtbot: QtBot, offline_restart: tuple[IOService, FolderCache, Path]) -> None:
    service, cache, data = offline_restart
    explorer = open_tab(qtbot, service, data)
    day, run_2 = str(data / "2026-10-20"), str(data / "2026-10-20/run_2")
    explorer.model.request_scan(day)
    answer(qtbot, service, "saved_list", day, lambda send: saved_list_folder(day, send, store_options()))
    select(qtbot, explorer, run_2)
    explorer.load_to_ram_cache(run_2)  # Even a deliberate load.
    assert not any(r.operation in ("load", "cached") for r in service.pending)
    assert "No cached data (offline)" in explorer.summary_text()
    explorer.close_cleanup()


