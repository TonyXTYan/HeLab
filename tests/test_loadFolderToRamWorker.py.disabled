@pytest.fixture
def worker():
    """Basic fixture to instantiate the worker with a default test folder."""
    return LoadFolderToRamWorker("test_folder")


#
# Example: if `fnum` is used to format bytes in the worker, you can also patch it
#          or provide a stub. If your project doesn't need it, remove or adapt.
#
@pytest.fixture
def mock_fnum():
    """Simple fnum stub to consistently return the same strings for testing."""
    def _fnum(bytes_size: int) -> str:
        # Stub: 2<<30 => 2147483648 => '2.00GB'
        if bytes_size >= (2 << 30):
            return "2.00GB"
        return f"{bytes_size}B"
    return _fnum


